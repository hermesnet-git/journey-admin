{
  "templateId": "escolha-lista-api",
  "name": "Escolha numa lista vinda de API",
  "track": "integracoes",
  "area": null,
  "channelTypes": [
    "WEB",
    "MOBILE",
    "WHATSAPP"
  ],
  "description": "Busca os planos à venda e deixa o cliente escolher um, com a ação liberada só nos disponíveis.",
  "highlights": [
    "Resposta da API gravada como lista",
    "Lista de seleção com ação liberada item a item",
    "Cada item montado com campos do plano"
  ],
  "flow": {
    "name": "Escolha numa lista vinda de API",
    "nodes": [
      {
        "nodeId": "Node_Inicio",
        "nodeType": "START",
        "name": "Início",
        "description": "Início da jornada",
        "positionX": 84,
        "positionY": 294,
        "userTaskConfig": null,
        "connectorConfig": null,
        "startVariables": null
      },
      {
        "nodeId": "Node_BuscaPlanos",
        "nodeType": "SERVICE_TASK",
        "name": "Busca planos à venda",
        "description": "Traz o catálogo comercial de planos.",
        "positionX": 221,
        "positionY": 281,
        "userTaskConfig": null,
        "connectorConfig": {
          "connectorType": "REST",
          "config": {
            "method": "GET",
            "url": "http://localhost:8084/v1/planos/ofertas",
            "headers": {
              "Accept": "application/json"
            },
            "outputMapping": [
              {
                "name": "quantidadePlanos",
                "jsonPath": "$.quantidade",
                "type": "number"
              },
              {
                "name": "planos",
                "jsonPath": "$.planos",
                "type": "list",
                "keepFields": [
                  "codigo",
                  "nome",
                  "franquia",
                  "preco",
                  "destaque",
                  "disponivel"
                ]
              }
            ]
          },
          "credentialRef": null
        },
        "startVariables": null
      },
      {
        "nodeId": "Node_EscolhePlano",
        "nodeType": "USER_TASK",
        "name": "Escolha o plano",
        "description": "Lista os planos e a ação de escolher.",
        "positionX": 371,
        "positionY": 281,
        "userTaskConfig": {
          "embeddedScreenRoot": {
            "id": "screen_escolheplano",
            "type": "ui.screen",
            "version": "1.0.0",
            "props": {
              "title": "Escolha seu plano",
              "scrollable": true,
              "paddingToken": "spacing.md",
              "backgroundToken": "color.background.primary"
            },
            "bindings": null,
            "events": null,
            "visibility": null,
            "active": null,
            "children": [
