                "bindings": null,
                "events": null,
                "visibility": null,
                "active": null,
                "children": [
                  {
                    "id": "txt_titulo",
                    "type": "ui.text",
                    "version": "1.0.0",
                    "props": {
                      "text": "Qual plano combina com você?",
                      "align": "start",
                      "variant": "title",
                      "maxLines": 2,
                      "colorToken": "color.text.primary"
                    },
                    "bindings": null,
                    "events": null,
                    "visibility": null,
                    "active": null,
                    "children": null
                  },
                  {
                    "id": "lst_planos",
                    "type": "ui.selectList",
                    "version": "1.0.0",
                    "props": {
                      "label": "Planos disponíveis",
                      "itemValue": "codigo",
                      "itemTitle": "{{item.nome}}",
                      "itemDescription": "{{item.franquia}} · R$ {{item.preco}}/mês",
                      "itemHint": "{{item.destaque}}",
                      "emptyMessage": "Nenhum plano disponível agora.",
                      "maxItems": 50,
                      "actions": [
                        {
                          "id": "escolher",
                          "label": "Quero este",
                          "variant": "primary",
                          "enabledWhen": "{{item.disponivel}} == true"
                        }
                      ],
                      "required": true
                    },
                    "bindings": {
                      "items": {
                        "path": "data.planos",
                        "mode": "oneWay"
                      },
                      "value": {
                        "path": "form.planoEscolhido",
                        "mode": "twoWay"
                      },
                      "action": {
                        "path": "form.acaoPlanoEscolhido",
                        "mode": "twoWay"
                      }
                    },
                    "events": {
                      "onAction": {
                        "action": "action.submit",
                        "params": {}
                      }
                    },
                    "visibility": null,
                    "active": null,
                    "children": null
