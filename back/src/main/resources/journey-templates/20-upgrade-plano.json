                    },
                    "bindings": null,
                    "events": {
                      "onPress": {
                        "action": "action.submit",
                        "params": {}
                      }
                    },
                    "visibility": null,
                    "active": null,
                    "children": null
                  }
                ]
              }
            ]
          },
          "dataSources": null
        },
        "connectorConfig": null,
        "startVariables": null
      },
      {
        "nodeId": "Node_FimTrocado",
        "nodeType": "END",
        "name": "Fim — upgrade feito",
        "description": "Fim — upgrade feito",
        "positionX": 1134,
        "positionY": 144,
        "userTaskConfig": null,
        "connectorConfig": null,
        "startVariables": null
      },
      {
        "nodeId": "Node_FimIndisponivel",
        "nodeType": "END",
        "name": "Fim — indisponível",
        "description": "Fim — indisponível",
        "positionX": 984,
        "positionY": 444,
        "userTaskConfig": null,
        "connectorConfig": null,
