<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<definitions xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_5a3a6581-864a-4fc3-ac34-d5b0ba5d44da" targetNamespace="http://bpmn.io/schema/bpmn" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <category id="Category_Sec_Consultas"><categoryValue id="CategoryValue_Sec_Consultas" value="Consultas e impedimentos"/></category><category id="Category_Sec_Reinicio"><categoryValue id="CategoryValue_Sec_Reinicio" value="Reinício do modem"/></category><category id="Category_Sec_Diagnostico"><categoryValue id="CategoryValue_Sec_Diagnostico" value="Diagnóstico automático"/></category><category id="Category_Sec_ReinicieNovamente"><categoryValue id="CategoryValue_Sec_ReinicieNovamente" value="Reiniciar novamente (ID 06, 07 ou 10)"/></category><category id="Category_Sec_SemEnergia"><categoryValue id="CategoryValue_Sec_SemEnergia" value="Sem energia (ID 09)"/></category><category id="Category_Sec_AberturaBD"><categoryValue id="CategoryValue_Sec_AberturaBD" value="Abertura de BD"/></category><process camunda:historyTimeToLive="180" camunda:versionTag="v2" id="Journey_c4de98d785254ffd8cdece66c0660830" isExecutable="true" name="Abertura de BD pelo VE">
    <startEvent id="Node_Start" name="Início">
      <outgoing>Flow_Start_ConsultaPendencia</outgoing>
    </startEvent>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_ConsultaPendencia" name="Consulta pendência financeira">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/clientes/${execution.getVariable('data_designador')}/pendencias-financeiras</camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Accept":"application/json"}</camunda:inputParameter>
          <camunda:outputParameter name="data_pendenciaHttpStatus">${statusCode}</camunda:outputParameter>
          <camunda:outputParameter name="data_faturasEmAtraso">${listOutput.extract(statusCode, response, "$.faturasPendentes", "referencia,valor,vencimento")}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_Start_ConsultaPendencia</incoming>
      <outgoing>Flow_ConsultaPendencia_ConsultaMassiva</outgoing>
    </serviceTask>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_ConsultaMassiva" name="Consulta massiva">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/clientes/${execution.getVariable('data_designador')}/manutencoes-massivas</camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Accept":"application/json"}</camunda:inputParameter>
          <camunda:outputParameter name="data_massivaHttpStatus">${statusCode}</camunda:outputParameter>
          <camunda:outputParameter name="data_massivaProtocolo">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.protocoloManutencao").element().value() : null}</camunda:outputParameter>
          <camunda:outputParameter name="data_massivaPrevisaoConclusao">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.previsaoConclusao").element().value() : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_ConsultaPendencia_ConsultaMassiva</incoming>
      <outgoing>Flow_ConsultaMassiva_ConsultaBD</outgoing>
    </serviceTask>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_ConsultaBD" name="Consulta BD aberto">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/clientes/${execution.getVariable('data_designador')}/bilhetes-defeito</camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Accept":"application/json"}</camunda:inputParameter>
          <camunda:outputParameter name="data_bdHttpStatus">${statusCode}</camunda:outputParameter>
          <camunda:outputParameter name="data_bdNumero">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.numeroBilhete").element().value() : null}</camunda:outputParameter>
          <camunda:outputParameter name="data_bdProtocoloAtendimento">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.protocoloAtendimento").element().value() : null}</camunda:outputParameter>
          <camunda:outputParameter name="data_bdPrevisaoConclusao">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.previsaoConclusao").element().value() : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_ConsultaMassiva_ConsultaBD</incoming>
      <outgoing>Flow_ConsultaBD_DecImpedimento</outgoing>
    </serviceTask>
    <exclusiveGateway default="Flow_DecImpedimento_Reinicie" id="Node_DecImpedimento" name="Cliente tem algum ponto de impedimento do serviço?">
      <incoming>Flow_ConsultaBD_DecImpedimento</incoming>
      <outgoing>Flow_DecImpedimento_StatusMassivaAtraso</outgoing>
      <outgoing>Flow_DecImpedimento_StatusMassivaVisita</outgoing>
      <outgoing>Flow_DecImpedimento_StatusMassiva</outgoing>
      <outgoing>Flow_DecImpedimento_StatusAtraso</outgoing>
      <outgoing>Flow_DecImpedimento_StatusVisita</outgoing>
      <outgoing>Flow_DecImpedimento_Reinicie</outgoing>
    </exclusiveGateway>
    <userTask id="Node_StatusMassivaAtraso" name="Massiva + atraso em pagamentos">
      <incoming>Flow_DecImpedimento_StatusMassivaAtraso</incoming>
      <outgoing>Flow_StatusMassivaAtraso_End_Impedimento</outgoing>
    </userTask>
    <userTask id="Node_StatusMassivaVisita" name="Massiva + visita técnica">
      <incoming>Flow_DecImpedimento_StatusMassivaVisita</incoming>
      <outgoing>Flow_StatusMassivaVisita_End_Impedimento</outgoing>
    </userTask>
    <userTask id="Node_StatusMassiva" name="Massiva">
      <incoming>Flow_DecImpedimento_StatusMassiva</incoming>
      <outgoing>Flow_StatusMassiva_End_Impedimento</outgoing>
    </userTask>
    <userTask id="Node_StatusAtraso" name="Atraso em pagamentos">
      <incoming>Flow_DecImpedimento_StatusAtraso</incoming>
      <outgoing>Flow_StatusAtraso_End_Impedimento</outgoing>
    </userTask>
    <userTask id="Node_StatusVisita" name="Visita técnica agendada">
      <incoming>Flow_DecImpedimento_StatusVisita</incoming>
      <outgoing>Flow_StatusVisita_End_Impedimento</outgoing>
    </userTask>
    <endEvent id="Node_End_Impedimento" name="Fim — impedimento">
      <incoming>Flow_StatusMassivaAtraso_End_Impedimento</incoming>
      <incoming>Flow_StatusMassivaVisita_End_Impedimento</incoming>
      <incoming>Flow_StatusMassiva_End_Impedimento</incoming>
      <incoming>Flow_StatusAtraso_End_Impedimento</incoming>
      <incoming>Flow_StatusVisita_End_Impedimento</incoming>
    </endEvent>
    <userTask id="Node_Reinicie" name="Reinicie o modem">
      <incoming>Flow_DecImpedimento_Reinicie</incoming>
      <outgoing>Flow_Reinicie_DecReinicio</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecReinicio_VoltouReinicio" id="Node_DecReinicio" name="Conseguiu reiniciar?">
      <incoming>Flow_Reinicie_DecReinicio</incoming>
      <outgoing>Flow_DecReinicio_TesteConexao</outgoing>
      <outgoing>Flow_DecReinicio_VoltouReinicio</outgoing>
    </exclusiveGateway>
    <userTask id="Node_VoltouReinicio" name="A internet voltou?">
      <incoming>Flow_DecReinicio_VoltouReinicio</incoming>
      <outgoing>Flow_VoltouReinicio_DecVoltouReinicio</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecVoltouReinicio_TesteConexao" id="Node_DecVoltouReinicio" name="Voltou após reiniciar?">
      <incoming>Flow_VoltouReinicio_DecVoltouReinicio</incoming>
      <outgoing>Flow_DecVoltouReinicio_InternetVoltou</outgoing>
      <outgoing>Flow_DecVoltouReinicio_TesteConexao</outgoing>
    </exclusiveGateway>
    <userTask id="Node_InternetVoltou" name="Sua internet voltou">
      <incoming>Flow_DecVoltouReinicio_InternetVoltou</incoming>
      <incoming>Flow_DecVoltouNovamente_InternetVoltou</incoming>
      <incoming>Flow_DecVoltouEnergia_InternetVoltou</incoming>
      <outgoing>Flow_InternetVoltou_End_Resolvido</outgoing>
    </userTask>
    <endEvent id="Node_End_Resolvido" name="Fim — problema resolvido">
      <incoming>Flow_InternetVoltou_End_Resolvido</incoming>
    </endEvent>
    <userTask id="Node_TesteConexao" name="Vamos testar a sua conexão">
      <incoming>Flow_DecReinicio_TesteConexao</incoming>
      <incoming>Flow_DecVoltouReinicio_TesteConexao</incoming>
      <outgoing>Flow_TesteConexao_DecTeste</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecTeste_SolicitaDiagnostico" id="Node_DecTeste" name="Cliente quer testar?">
      <incoming>Flow_TesteConexao_DecTeste</incoming>
      <outgoing>Flow_DecTeste_End_Desistiu</outgoing>
      <outgoing>Flow_DecTeste_SolicitaDiagnostico</outgoing>
    </exclusiveGateway>
    <endEvent id="Node_End_Desistiu" name="Fim — cliente voltou ao início">
      <incoming>Flow_DecTeste_End_Desistiu</incoming>
    </endEvent>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_SolicitaDiagnostico" name="Solicita diagnóstico (HPSD)">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/diagnosticos/solicitacoes</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Content-Type":"application/json"}</camunda:inputParameter>
          <camunda:inputParameter name="payload">{"designador":"${execution.getVariable('data_designador')}","tipoAvaliacao":"CONECTIVIDADE_E_SINAL"}</camunda:inputParameter>
          <camunda:outputParameter name="data_diagnosticoProtocolo">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.protocolo").element().value() : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_DecTeste_SolicitaDiagnostico</incoming>
      <outgoing>Flow_SolicitaDiagnostico_AguardaDiagnostico</outgoing>
    </serviceTask>
    <receiveTask id="Node_AguardaDiagnostico" messageRef="Message_Node_AguardaDiagnostico" name="Aguarda resultado do diagnóstico">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="credentialRef">teste</camunda:inputParameter>
          <camunda:inputParameter name="connectorType">KAFKA</camunda:inputParameter>
          <camunda:inputParameter name="topic">eljy.eventos.entrada</camunda:inputParameter>
          <camunda:inputParameter name="clusterId">6590dbdc-6ab8-433f-9baf-0c271486157b</camunda:inputParameter>
          <camunda:inputParameter name="operation">CONSUME</camunda:inputParameter>
          <camunda:inputParameter name="waitTimeoutMs">180000</camunda:inputParameter>
          <camunda:inputParameter name="outputMapping.idRetornoDiagnostico">$.payload.data.idRetorno</camunda:inputParameter>
          <camunda:inputParameter name="outputMapping.idRetornoDiagnostico.type">string</camunda:inputParameter>
          <camunda:outputParameter name="data_idRetornoDiagnostico">${execution.getVariable('idRetornoDiagnostico')}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_SolicitaDiagnostico_AguardaDiagnostico</incoming>
      <outgoing>Flow_AguardaDiagnostico_DecIdDiagnostico</outgoing>
    </receiveTask>
    <exclusiveGateway default="Flow_DecIdDiagnostico_AgendarVisita" id="Node_DecIdDiagnostico" name="IDs de respostas do diagnóstico">
      <incoming>Flow_AguardaDiagnostico_DecIdDiagnostico</incoming>
      <outgoing>Flow_DecIdDiagnostico_ReinicieNovamente</outgoing>
      <outgoing>Flow_DecIdDiagnostico_SemEnergia</outgoing>
      <outgoing>Flow_DecIdDiagnostico_AgendarVisita</outgoing>
    </exclusiveGateway>
    <userTask id="Node_ReinicieNovamente" name="Reinicie de novo">
      <incoming>Flow_DecIdDiagnostico_ReinicieNovamente</incoming>
      <outgoing>Flow_ReinicieNovamente_VoltouNovamente</outgoing>
    </userTask>
    <userTask id="Node_VoltouNovamente" name="A internet voltou?">
      <incoming>Flow_ReinicieNovamente_VoltouNovamente</incoming>
      <outgoing>Flow_VoltouNovamente_DecVoltouNovamente</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecVoltouNovamente_AgendarVisita" id="Node_DecVoltouNovamente" name="Voltou após o ajuste?">
      <incoming>Flow_VoltouNovamente_DecVoltouNovamente</incoming>
      <outgoing>Flow_DecVoltouNovamente_InternetVoltou</outgoing>
      <outgoing>Flow_DecVoltouNovamente_AgendarVisita</outgoing>
    </exclusiveGateway>
    <userTask id="Node_SemEnergia" name="Modem sem energia">
      <incoming>Flow_DecIdDiagnostico_SemEnergia</incoming>
      <outgoing>Flow_SemEnergia_DecEnergia</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecEnergia_VoltouEnergia" id="Node_DecEnergia" name="Conseguiu verificar?">
      <incoming>Flow_SemEnergia_DecEnergia</incoming>
      <outgoing>Flow_DecEnergia_AgendarVisita</outgoing>
      <outgoing>Flow_DecEnergia_VoltouEnergia</outgoing>
    </exclusiveGateway>
    <userTask id="Node_VoltouEnergia" name="A internet voltou?">
      <incoming>Flow_DecEnergia_VoltouEnergia</incoming>
      <outgoing>Flow_VoltouEnergia_DecVoltouEnergia</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecVoltouEnergia_TemEnergia" id="Node_DecVoltouEnergia" name="Voltou após verificar?">
      <incoming>Flow_VoltouEnergia_DecVoltouEnergia</incoming>
      <outgoing>Flow_DecVoltouEnergia_InternetVoltou</outgoing>
      <outgoing>Flow_DecVoltouEnergia_TemEnergia</outgoing>
    </exclusiveGateway>
    <userTask id="Node_TemEnergia" name="Tem energia no endereço?">
      <incoming>Flow_DecVoltouEnergia_TemEnergia</incoming>
      <outgoing>Flow_TemEnergia_DecTemEnergia</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecTemEnergia_RedeEletrica" id="Node_DecTemEnergia" name="Há energia no endereço?">
      <incoming>Flow_TemEnergia_DecTemEnergia</incoming>
      <outgoing>Flow_DecTemEnergia_AgendarVisita</outgoing>
      <outgoing>Flow_DecTemEnergia_RedeEletrica</outgoing>
    </exclusiveGateway>
    <userTask id="Node_RedeEletrica" name="Problema na rede elétrica">
      <incoming>Flow_DecTemEnergia_RedeEletrica</incoming>
      <outgoing>Flow_RedeEletrica_End_RedeEletrica</outgoing>
    </userTask>
    <endEvent id="Node_End_RedeEletrica" name="Fim — rede elétrica">
      <incoming>Flow_RedeEletrica_End_RedeEletrica</incoming>
    </endEvent>
    <userTask id="Node_AgendarVisita" name="Vamos agendar uma visita técnica">
      <incoming>Flow_AguardaDiagnostico_AgendarVisita_Falha</incoming>
      <incoming>Flow_DecIdDiagnostico_AgendarVisita</incoming>
      <incoming>Flow_DecVoltouNovamente_AgendarVisita</incoming>
      <incoming>Flow_DecEnergia_AgendarVisita</incoming>
      <incoming>Flow_DecTemEnergia_AgendarVisita</incoming>
      <outgoing>Flow_AgendarVisita_DecAgendar</outgoing>
    </userTask>
    <exclusiveGateway default="Flow_DecAgendar_ConsultaSlots" id="Node_DecAgendar" name="Cliente quer agendar?">
      <incoming>Flow_AgendarVisita_DecAgendar</incoming>
      <outgoing>Flow_DecAgendar_End_SemAgendar</outgoing>
      <outgoing>Flow_DecAgendar_ConsultaSlots</outgoing>
    </exclusiveGateway>
    <endEvent id="Node_End_SemAgendar" name="Fim — sem agendamento">
      <incoming>Flow_DecAgendar_End_SemAgendar</incoming>
    </endEvent>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_ConsultaSlots" name="Consulta horários (WFM)">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/instalacoes/horarios-disponiveis?designador=${execution.getVariable('data_designador')}</camunda:inputParameter>
          <camunda:inputParameter name="method">GET</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Accept":"application/json"}</camunda:inputParameter>
          <camunda:outputParameter name="data_horariosVisita">${listOutput.extract(statusCode, response, "$.horarios", "value,label")}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_DecAgendar_ConsultaSlots</incoming>
      <incoming>Flow_HorarioOcupado_ConsultaSlots</incoming>
      <outgoing>Flow_ConsultaSlots_EscolheHorario</outgoing>
    </serviceTask>
    <userTask id="Node_EscolheHorario" name="Escolha do horário">
      <incoming>Flow_ConsultaSlots_EscolheHorario</incoming>
      <outgoing>Flow_EscolheHorario_CriaWO</outgoing>
    </userTask>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_CriaWO" name="Cria WO (WFM)">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/instalacoes/agendamentos</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Content-Type":"application/json"}</camunda:inputParameter>
          <camunda:inputParameter name="payload">{"data":"${execution.getVariable('form_dataVisita')}","horario":"${execution.getVariable('form_horarioVisita')}","designador":"${execution.getVariable('data_designador')}","avisarHorarioMaisCedo":"${execution.getVariable('form_avisarHorarioMaisCedo')}"}</camunda:inputParameter>
          <camunda:outputParameter name="data_woNumero">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.protocolo").element().value() : null}</camunda:outputParameter>
          <camunda:outputParameter name="data_woStatus">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.status").element().value() : null}</camunda:outputParameter>
          <camunda:outputParameter name="data_woHorario">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.horario").element().value() : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_EscolheHorario_CriaWO</incoming>
      <outgoing>Flow_CriaWO_DecAgendado</outgoing>
    </serviceTask>
    <exclusiveGateway default="Flow_DecAgendado_HorarioOcupado" id="Node_DecAgendado" name="Agendado com sucesso?">
      <incoming>Flow_CriaWO_DecAgendado</incoming>
      <outgoing>Flow_DecAgendado_CriaBD</outgoing>
      <outgoing>Flow_DecAgendado_HorarioOcupado</outgoing>
    </exclusiveGateway>
    <userTask id="Node_HorarioOcupado" name="Horário ocupado">
      <incoming>Flow_DecAgendado_HorarioOcupado</incoming>
      <outgoing>Flow_HorarioOcupado_ConsultaSlots</outgoing>
    </userTask>
    <serviceTask camunda:delegateExpression="${httpConnectorDelegate}" id="Node_CriaBD" name="Cria BD">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="readTimeoutMs">30000</camunda:inputParameter>
          <camunda:inputParameter name="retries">1</camunda:inputParameter>
          <camunda:inputParameter name="retryIntervalMs">1000</camunda:inputParameter>
          <camunda:inputParameter name="hasErrorPath">true</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/suporte/chamados</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Content-Type":"application/json"}</camunda:inputParameter>
          <camunda:inputParameter name="payload">{"numeroWO":"${execution.getVariable('data_woNumero')}","designador":"${execution.getVariable('data_designador')}","protocoloDiagnostico":"${execution.getVariable('data_diagnosticoProtocolo')}"}</camunda:inputParameter>
          <camunda:outputParameter name="data_bdCriadoHttpStatus">${statusCode}</camunda:outputParameter>
          <camunda:outputParameter name="data_bdCriadoNumero">${statusCode &gt;= 200 &amp;&amp; statusCode &lt; 300 ? S(response).jsonPath("$.numeroChamado").element().value() : null}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <incoming>Flow_DecAgendado_CriaBD</incoming>
      <outgoing>Flow_CriaBD_DecBDCriado</outgoing>
    </serviceTask>
    <exclusiveGateway default="Flow_DecBDCriado_CancelaWO" id="Node_DecBDCriado" name="BD criado?">
      <incoming>Flow_CriaBD_DecBDCriado</incoming>
      <outgoing>Flow_DecBDCriado_VisitaAgendada</outgoing>
      <outgoing>Flow_DecBDCriado_CancelaWO</outgoing>
    </exclusiveGateway>
    <userTask id="Node_VisitaAgendada" name="Você agendou a visita técnica">
      <incoming>Flow_DecBDCriado_VisitaAgendada</incoming>
      <outgoing>Flow_VisitaAgendada_End_Agendado</outgoing>
    </userTask>
    <endEvent id="Node_End_Agendado" name="Fim — visita agendada e BD criado">
      <incoming>Flow_VisitaAgendada_End_Agendado</incoming>
    </endEvent>
    <serviceTask camunda:asyncBefore="true" camunda:delegateExpression="${httpConnectorDelegate}" id="Node_CancelaWO" name="Cancela WO (WFM)">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="hasErrorPath">false</camunda:inputParameter>
          <camunda:inputParameter name="url">http://localhost:8084/v1/ordens-servico/${execution.getVariable('data_woNumero')}/encerramento</camunda:inputParameter>
          <camunda:inputParameter name="method">POST</camunda:inputParameter>
          <camunda:inputParameter name="headers">{"Content-Type":"application/json"}</camunda:inputParameter>
